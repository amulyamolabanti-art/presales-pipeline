# ==============================================================================
# Presales AI Proposal Assistant — Frontend Environment Configuration (/src/tab)
# ==============================================================================
# Base URL for the Presales Mock API (Story 2 / APA-46) or Backend Service.
#
# Default local mock server port is 5000 (http://localhost:5000).
# In production or staging, replace with your backend gateway URL.
#
# NOTE: In Vite, variables prefixed with VITE_ are injected at build/start time.
# If you add or modify variables in .env or .env.local, you must RESTART the
# Vite dev server (npm run dev) or REBUILD (npm run build) for changes to take effect.
# ==============================================================================

VITE_API_BASE_URL=http://localhost:5000
